# =============================================================================
# Assistente de Detecção com RAG — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o .env com chaves reais.
# =============================================================================

# --- Provedores de LLM / embedding (ver CLAUDE.md, seção 3) ---
# As duas camadas são escolhidas de forma independente, de propósito: a
# Anthropic não expõe uma API de embeddings própria (ver bloco de embedding
# abaixo), então o par natural é gerar com uma e embeddar com outra.
#
# LLM_PROVIDER (geração, Fase 5):       "anthropic" | "openai"
# EMBEDDING_PROVIDER (vetores, Fase 3): "openai" | "voyage"
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# Preencha a chave do provedor que escolheu acima. Não é necessário ter todas.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Modelos de geração ---
ANTHROPIC_LLM_MODEL=claude-opus-5
OPENAI_LLM_MODEL=gpt-5

# --- Modelos de embedding ---
# DECISÃO DE ARQUITETURA (Fase 3, ver PROGRESS.md): o padrão é
# text-embedding-3-small, de 1536 dimensões, e não o 3-large de 3072.
# O motivo é concreto, não preferência: os índices HNSW e IVFFlat do pgvector
# só aceitam até 2000 dimensões. Com 3072 a busca vetorial cairia em varredura
# sequencial, ou exigiria o tipo halfvec e a perda de precisão que vem junto.
#
# `EMBEDDING_PROVIDER=anthropic` não existe: a Anthropic recomenda a Voyage AI
# para embeddings, que é outra API e outra chave (VOYAGE_API_KEY acima).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_EMBEDDING_MODEL=voyage-3

# --- Banco de dados (Postgres + pgvector, via docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=detection_rag
POSTGRES_USER=detection_rag
POSTGRES_PASSWORD=change-me-in-local-env

# String de conexão montada a partir das variáveis acima (uso interno da app).
DATABASE_URL=postgresql://detection_rag:change-me-in-local-env@localhost:5432/detection_rag

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Retrieval / RAG (defaults ajustáveis conforme avaliação da Fase 6) ---
RETRIEVAL_TOP_K=5
