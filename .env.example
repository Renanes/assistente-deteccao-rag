# =============================================================================
# Assistente de Detecção com RAG — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o .env com chaves reais.
# =============================================================================

# --- Provedores de LLM / embedding (ver CLAUDE.md, seção 3) ---
# Escolha qual provedor cada camada usa: "anthropic" ou "openai".
LLM_PROVIDER=anthropic
EMBEDDING_PROVIDER=anthropic

# Preencha ao menos uma das chaves abaixo (a que corresponder ao provedor
# escolhido acima). Não é necessário ter as duas.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelos padrão por provedor (sobrescrevível; documentar no README qual foi
# usado na avaliação da Fase 6, já que a qualidade de retrieval varia entre
# modelos de embedding diferentes).
# NOTA (a resolver na Fase 3): a Anthropic não expõe uma API de embeddings
# própria — o caminho recomendado por eles é a Voyage AI. Placeholder abaixo
# até a decisão de arquitetura da camada de embeddings ser tomada e registrada
# em PROGRESS.md.
ANTHROPIC_LLM_MODEL=claude-sonnet-5
ANTHROPIC_EMBEDDING_MODEL=voyage-3
OPENAI_LLM_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- Banco de dados (Postgres + pgvector, via docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=detection_rag
POSTGRES_USER=detection_rag
POSTGRES_PASSWORD=change-me-in-local-env

# String de conexão montada a partir das variáveis acima (uso interno da app).
DATABASE_URL=postgresql://detection_rag:change-me-in-local-env@localhost:5432/detection_rag

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Retrieval / RAG (defaults ajustáveis conforme avaliação da Fase 6) ---
RETRIEVAL_TOP_K=5
