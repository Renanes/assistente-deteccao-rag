/*
 * Fixture de borda montada a partir de padrões reais do repositório
 * chronicle/detection-rules, combinando três peculiaridades que o parser
 * precisa tratar e que não aparecem juntas numa única regra upstream:
 *   1. `{` na linha seguinte ao cabeçalho `rule` (66 arquivos do repo);
 *   2. ausência de `rule_id` e de `rule_name` no meta (fallback de ID/título);
 *   3. `mitre = "credential_access, t1003"` — ID ATT&CK solto em texto livre,
 *      minúsculo, no meio de uma lista separada por vírgula;
 *   4. `reference` repetido, que não pode perder nenhuma entrada.
 */

rule info_certutil_urlcache
{
  meta:
    author = "Google Cloud Security"
    description = "Certutil making an HTTP connection"
    reference = "https://attack.mitre.org/techniques/T1003/"
    reference = "https://tdm.socprime.com/tdm/info/WeCGGZ763x50"
    version = "0.01"
    created = "2021-03-09"
    category = "process_creation"
    product = "windows"
    mitre = "credential_access, t1003"
    yara_version = "YL2.0"
    rule_version = "1.0"

  events:
    $e1.metadata.event_type = "PROCESS_LAUNCH"
    re.regex($e1.principal.process.command_line, `\bcertutil(\.exe)?\b.+\burlcache\b`) nocase

  condition:
    $e1
}
